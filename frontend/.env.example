# Base URL of the Cribra FastAPI backend, including the /api prefix.
# Copy this file to .env and adjust for your environment.
#
# Vite inlines this at BUILD time, so:
#   - restart the dev server after changing it
#   - rebuild (not just redeploy) when targeting a new backend
#
# Any origin other than localhost:5173 must also be added to allow_origins
# in backend/app/main.py, or the browser will block the request via CORS.
VITE_API_BASE_URL=http://localhost:8000/api
