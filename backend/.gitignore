# Environment — never commit secrets
.env

# Internal build docs — not committed (README.md is the exception)
*.md
!README.md
Milestone Update/
.claude/

# One-off manual real-data validation scripts (not part of the app)
test.py
compare_ocr_vs_vision.py
dump_page_range.py
locate_certificates.py

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/

# Vector store data
data/chroma/*
!data/chroma/.gitkeep

# Uploaded contractor submission documents
data/uploads/*
!data/uploads/.gitkeep

# GPT-4o vision page-transcription cache (dev-run cost/latency optimization)
data/vision_cache/*
!data/vision_cache/.gitkeep

# Real field-collected documents (contractor submissions, BPP SBD)
tests/fixtures/real/*
!tests/fixtures/real/.gitkeep

# Expert ground-truth review (real company/personal data — same reasoning as
# tests/fixtures/real/ above)
COMPANY PROFILE CHECK CONTRACTORs*.pdf

# Evaluation outputs — contain real extracted data (company names, RC
# numbers, TINs, financial figures) from the real submissions above; local
# artifacts only, not committed.
evaluation/results/*
!evaluation/results/.gitkeep

