OPENAI_API_KEY=sk-your-key-here
CHROMA_PERSIST_DIR=./data/chroma
LOG_LEVEL=INFO
OPENAI_VISION_CONCURRENCY=2
OPENAI_FIELD_EXTRACTION_CONCURRENCY=2
OPENAI_EVALUATION_CONCURRENCY=2
OPENAI_RATE_LIMIT_RETRIES=6
OPENAI_RETRY_BASE_DELAY_SECONDS=3.0
# Changing this invalidates the whole vision cache (it is keyed by rendered
# image), and it is not a cost lever — see app/config.py.
PDF_RENDER_ZOOM=2.0
